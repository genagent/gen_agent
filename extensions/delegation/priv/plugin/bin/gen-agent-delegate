#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime="$plugin_root/runtime/bin/delegation_spike"

if [ ! -x "$runtime" ]; then
  echo "GenAgent Delegate runtime is missing or not executable. For an exported bundle, re-extract the complete package with executable permissions preserved. From a source checkout, export a new package from extensions/delegation with MIX_ENV=prod mix gen_agent.plugin.build --output /absolute/new/plugin-dir." >&2
  exit 1
fi

# Select this bundled release, never the OTP release hosting the caller.
unset RELEASE_NAME RELEASE_VSN RELEASE_COOKIE RELEASE_NODE RELEASE_TMP \
  RELEASE_VM_ARGS RELEASE_REMOTE_VM_ARGS RELEASE_SYS_CONFIG RELEASE_MODE \
  RELEASE_BOOT_SCRIPT RELEASE_BOOT_SCRIPT_CLEAN RELEASE_PROG RELEASE_COMMAND \
  RELEASE_ROOT BINDIR ROOTDIR ERL_ROOTDIR

export RELEASE_DISTRIBUTION=none
export GEN_AGENT_DELEGATE_LAUNCH_PATH="$plugin_root/bin/gen-agent-delegate"
. "$plugin_root/bin/runtime-crypto.sh"
configure_runtime_crypto "$plugin_root"
exec "$runtime" eval "$runtime_crypto_restore GenAgent.Delegation.MCP.serve()"
