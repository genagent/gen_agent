{
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "elixir",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "exclude-paths": [
        "integrations/claude",
        "integrations/codex",
        "integrations/anthropic",
        "integrations/openai",
        "extensions/ensemble",
        ".github",
        "scripts",
        "design",
        "RELEASING.md",
        "MIGRATION.md"
      ],
      "extra-files": ["README.md", "lib/gen_agent.ex"]
    },
    "integrations/claude": {
      "release-type": "elixir",
      "component": "gen_agent_claude",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "extra-files": ["README.md"]
    },
    "integrations/codex": {
      "release-type": "elixir",
      "component": "gen_agent_codex",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "extra-files": ["README.md"]
    },
    "integrations/anthropic": {
      "release-type": "elixir",
      "component": "gen_agent_anthropic",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "extra-files": ["README.md"]
    },
    "integrations/openai": {
      "release-type": "elixir",
      "component": "gen_agent_openai",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "extra-files": ["README.md"]
    },
    "extensions/ensemble": {
      "release-type": "elixir",
      "component": "gen_agent_ensemble",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "extra-files": ["README.md"]
    }
  }
}
